# SaiSai v3 · ตัวอย่างค่า env (ค่าเริ่มต้นโหมด mock) — คัดลอกเป็น .env ได้ · ห้าม commit .env จริง
# ค่า AI จริง: .env.vast (LLM_BASE_URL LLM_MODEL LLM_API_KEY) · .env.aibox (STT_URL TTS_URL RERANK_URL AIBOX_API_KEY)
MODE=mock
LLM_BASE_URL=http://mock-llm:8000/v1
LLM_MODEL=mock
LLM_API_KEY=mock
STT_URL=http://mock-llm:8000
TTS_URL=http://mock-llm:8000
RERANK_URL=http://mock-llm:8000
AIBOX_API_KEY=mock
RERANK=on
CHAT_PREFETCH=4
STT_PREFETCH=4
TTS_PREFETCH=2
EVAL_TOKEN=ss-eval
DATABASE_URL=postgres://ss:ss@db:5432/saisai
AMQP_URL=amqp://guest:guest@rabbitmq:5672
ALLOW_TEST_RESET=1
# --- เสริม ---
EMBED_URL=http://embedder:80
MQ_PREFIX=
MOCK_LATENCY_MS=800
SESSION_SECRET=change-me-dev-only
WEB_PORT=3600
MQ_UI_PORT=15672
MQ_API=http://localhost:15672
